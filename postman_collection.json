{
  "info": {
    "name": "SportZone API Collection",
    "description": "Pre-configured Postman requests for all 15 endpoints in SportZone",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@sportzone.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Demo\",\n  \"lastName\": \"User\"\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/auth/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@sportzone.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "auth", "login"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sportzone.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Sports & Facilities",
      "item": [
        {
          "name": "Get All Sports",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/v1/sports", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "sports"] }
          }
        },
        {
          "name": "Get All Facilities",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/v1/facilities", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "facilities"] }
          }
        },
        {
          "name": "Get Single Facility",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/v1/facilities/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "facilities", "1"] }
          }
        },
        {
          "name": "Check Facility Availability",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/v1/facilities/1/availability?date=2026-08-15", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "facilities", "1", "availability"], "query": [{ "key": "date", "value": "2026-08-15" }] }
          }
        },
        {
          "name": "Create Facility (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sportId\": 1,\n  \"name\": \"Badminton Court 5\",\n  \"description\": \"VIP Court\",\n  \"capacity\": 4\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/facilities", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "facilities"] }
          }
        },
        {
          "name": "Deactivate Facility (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/v1/facilities/1/deactivate", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "facilities", "1", "deactivate"] }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"facilityId\": 1,\n  \"startTime\": \"2026-08-15T15:00:00\",\n  \"endTime\": \"2026-08-15T17:00:00\"\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/bookings", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "bookings"] }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/v1/bookings/my", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "bookings", "my"] }
          }
        },
        {
          "name": "Get All Bookings (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/v1/bookings/all", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "bookings", "all"] }
          }
        },
        {
          "name": "Get Facility Bookings (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/v1/bookings/facility/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "bookings", "facility", "1"] }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/v1/bookings/{{booking_uuid}}", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "bookings", "{{booking_uuid}}"] }
          }
        }
      ]
    },
    {
      "name": "Blocked Slots",
      "item": [
        {
          "name": "Create Blocked Slot (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"facilityId\": 1,\n  \"startTime\": \"2026-08-16T08:00:00\",\n  \"endTime\": \"2026-08-16T12:00:00\",\n  \"reason\": \"Maintenance\"\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/blocked-slots", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "blocked-slots"] }
          }
        },
        {
          "name": "Get All Blocked Slots (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/v1/blocked-slots", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "blocked-slots"] }
          }
        },
        {
          "name": "Delete Blocked Slot (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "url": { "raw": "http://localhost:8080/v1/blocked-slots/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "blocked-slots", "1"] }
          }
        }
      ]
    }
  ]
}
